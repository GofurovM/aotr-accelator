// aotr_start.exe's resources: the ring icons (the first one is the program's own icon) and its version.
#include <windows.h>
101 ICON "..\\res\\aotr_gold.ico"
102 ICON "..\\res\\aotr_yellow.ico"
103 ICON "..\\res\\aotr_red.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 84,0,0,134
 PRODUCTVERSION 84,0,0,134
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "AOTR Accelerator - starter"
            VALUE "FileVersion", "84 (build 134)"
            VALUE "ProductName", "AOTR Accelerator"
            VALUE "ProductVersion", "84 (build 134)"
            VALUE "OriginalFilename", "AOTR_ACCELERATOR.exe"
            VALUE "LegalCopyright", "MIT license - based on BFME2 Accelerator by Ohad Baehr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
